# ==============================================================================
# Helios — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` and adjust values for your deployment environment.
# ==============================================================================

# Directory inside the container where SQLite (memory.db) and Markdown exports live.
MEMORY_DATA_DIR=/data

# Zero-Trust API Key for authenticating MCP (/sse, /mcp), export (/export/*),
# and full health telemetry requests.
# - Leave empty/unset for open local or private mesh mode.
# - Set a strong random token (e.g., `openssl rand -hex 32`) when exposing on a
#   public VPS or cloud reverse proxy. Supports `Authorization: Bearer <key>`
#   and `?token=<key>` query parameter.
HELIOS_API_KEY=

# Shared secret for validating incoming Git push webhooks (`POST /webhook/git`).
# Supports GitHub (`X-Hub-Signature-256`), Forgejo/Gitea (`X-Forgejo-Signature` /
# `X-Gitea-Signature`), and GitLab (`X-Gitlab-Token`).
HELIOS_WEBHOOK_SECRET=

# Enforce fail-closed webhook rejection (503) if HELIOS_WEBHOOK_SECRET is unset.
HELIOS_REQUIRE_WEBHOOK_SECRET=false

# Maximum number of words allowed per atomic memory fact in the AUDN Write Gate.
HELIOS_WORD_LIMIT=25

# Number of days of inactivity before 'episodic' memories are automatically archived.
HELIOS_EPISODIC_TTL_DAYS=14

# Maximum number of historical (superseded/archived) records retained per scope
# in exported changelog Markdown files (`exports/changelog/<scope>_history.md`).
HELIOS_CHANGELOG_LIMIT=100

# Comma-separated list of allowed CORS origins (or `*` to allow all origins).
HELIOS_ALLOWED_ORIGINS=*
