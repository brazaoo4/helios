# ==============================================================================
# Helios — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` and adjust values for your deployment environment.
# ==============================================================================

# Directory inside the container where SQLite (memory.db) and Markdown exports live.
MEMORY_DATA_DIR=/data

# Zero-Trust API Key for authenticating MCP (/sse, /mcp), export (/export/*),
# and full health telemetry requests.
# - Leave empty/unset for open local or private mesh mode.
# - Set a strong random token (e.g., `openssl rand -hex 32`) when exposing on a
#   public VPS or cloud reverse proxy. Supports `Authorization: Bearer <key>`
#   and `?token=<key>` query parameter.
HELIOS_API_KEY=

# Shared secret for validating incoming Git push webhooks (`POST /webhook/git`).
# Supports GitHub (`X-Hub-Signature-256`), Forgejo/Gitea (`X-Forgejo-Signature` /
# `X-Gitea-Signature`), and GitLab (`X-Gitlab-Token`).
HELIOS_WEBHOOK_SECRET=

# Enforce fail-closed webhook rejection (503) if HELIOS_WEBHOOK_SECRET is unset.
# Leave empty to automatically require webhook secrets whenever HELIOS_API_KEY is set.
HELIOS_REQUIRE_WEBHOOK_SECRET=

# Comma-separated proxy IPs trusted for X-Forwarded-* headers (defaults to 127.0.0.1).
FORWARDED_ALLOW_IPS=127.0.0.1

# Host IP binding for Docker Compose port mapping (defaults to 127.0.0.1).
HELIOS_BIND_IP=127.0.0.1

# Maximum number of words allowed per atomic memory fact in the AUDN Write Gate.
HELIOS_WORD_LIMIT=25

# Number of days of inactivity before 'episodic' memories are automatically archived.
HELIOS_EPISODIC_TTL_DAYS=14

# Maximum number of historical (superseded/archived) records retained per scope
# in exported changelog Markdown files (`exports/changelog/<scope>_history.md`).
HELIOS_CHANGELOG_LIMIT=100

# Comma-separated list of allowed browser Origins (or `*` to allow all origins).
# Empty/unset denies cross-origin browser requests while permitting CLI/IDE clients without Origin.
HELIOS_ALLOWED_ORIGINS=

# Optional public or mesh base URL override for AI client `/setup` generation
# (e.g., https://helios.example.com). Falls back to incoming request host headers.
HELIOS_PUBLIC_URL=

# ==============================================================================
# Git Provider Integration (Optional — for conversational `manage_git_webhooks`)
# ==============================================================================
# Supported providers: forgejo, gitea, github, gitlab
HELIOS_GIT_PROVIDER=

# Base URL of the Git instance API (e.g. https://git.example.com or https://api.github.com)
HELIOS_GIT_API_URL=

# Personal Access Token with repository / webhook management scope
HELIOS_GIT_TOKEN=

# Optional organization or username filter; defaults to authenticated token owner
HELIOS_GIT_OWNER=

# Target Helios webhook URL registered on Git providers (e.g., https://helios.example.com/webhook/git)
HELIOS_WEBHOOK_URL=

# ==============================================================================
# Optional Gemini AI Features (Semantic RRF Search, Diff Triage, Contradictions)
# ==============================================================================
# Google Gemini API key (leave empty to remain 100% local/lexical)
HELIOS_GEMINI_API_KEY=

# Toggle hybrid 256-d Matryoshka vector search when HELIOS_GEMINI_API_KEY is set
HELIOS_SEMANTIC_SEARCH=true

# ==============================================================================
# Structured Logging
# ==============================================================================
# Log level for helios.* loggers (DEBUG, INFO, WARNING, ERROR)
HELIOS_LOG_LEVEL=INFO

# Output format: text (human-readable) or json (structured JSON lines)
HELIOS_LOG_FORMAT=text
